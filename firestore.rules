rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    match /Users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    match /Curriculum/{techId} {
      allow read: if isAuthenticated();
      allow write: if false; // We will lock this down to 'Admins Only' later
    }
    
    match /Logs/{logId} {
      // Students can only access their own training logs
      allow create: if isAuthenticated() && request.resource.data.StudentEmail == request.auth.token.email;
      allow read, update, delete: if isAuthenticated() && resource.data.StudentEmail == request.auth.token.email;
    }
    
    match /Notes/{noteId} {
      // Students can only access their own private notes
      allow create: if isAuthenticated() && request.resource.data.StudentEmail == request.auth.token.email;
      allow read, update, delete: if isAuthenticated() && resource.data.StudentEmail == request.auth.token.email;
    }
    
    match /Badges/{badgeId} {
      // Badges are view-only for the student who owns them
      allow read: if isAuthenticated() && resource.data.StudentEmail == request.auth.token.email;
      allow write: if false; 
    }
    
    match /Announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
  }
}
